{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uraifoundation.org/standards/registry.schema.json",
  "title": "URAI Foundation Standards Registry",
  "type": "object",
  "required": [
    "schema_version",
    "registry_status",
    "last_reviewed",
    "controlling_language",
    "conformance_program",
    "certification_program",
    "standards"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "registry_status": { "enum": ["formation-draft", "public-review", "operational", "deprecated"] },
    "last_reviewed": { "type": "string", "format": "date" },
    "controlling_language": { "type": "string", "minLength": 2 },
    "conformance_program": { "enum": ["not-established", "self-attestation", "reviewed-implementation"] },
    "certification_program": { "const": "not-established" },
    "standards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "version",
          "status",
          "normative_strength",
          "path",
          "owner_role",
          "review_required",
          "public_comment",
          "conformance"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^URAI-[A-Z]{3}-[0-9]{3}$" },
          "title": { "type": "string", "minLength": 3 },
          "version": { "type": "string", "minLength": 4 },
          "status": { "enum": ["formation-draft", "public-review", "adopted", "superseded", "withdrawn"] },
          "normative_strength": { "enum": ["informational", "guidance", "normative"] },
          "path": { "type": "string", "pattern": "^docs/.+\\.md$" },
          "owner_role": { "type": "string", "minLength": 3 },
          "review_required": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 2 },
            "uniqueItems": true
          },
          "public_comment": { "enum": ["not-open", "open", "closed", "not-required"] },
          "conformance": { "enum": ["not-available", "self-attestation", "reviewed-implementation"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
