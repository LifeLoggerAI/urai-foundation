rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activeStaff() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.foundation_staff == true
        && exists(/databases/$(database)/documents/foundationStaff/$(request.auth.uid))
        && get(/databases/$(database)/documents/foundationStaff/$(request.auth.uid)).data.isActive == true
        && get(/databases/$(database)/documents/foundationStaff/$(request.auth.uid)).data.role
          == request.auth.token.foundation_role
        && request.auth.token.foundation_role in ['owner', 'admin', 'reviewer', 'grant_writer', 'staff'];
    }

    function role() {
      return request.auth.token.foundation_role;
    }

    function writerOrAbove() {
      return activeStaff() && role() in ['owner', 'admin', 'grant_writer', 'reviewer'];
    }

    function reviewerOrAbove() {
      return activeStaff() && role() in ['owner', 'admin', 'reviewer'];
    }

    function adminOrOwner() {
      return activeStaff() && role() in ['owner', 'admin'];
    }

    function sameCreatorOnCreate() {
      return request.resource.data.createdBy == request.auth.uid;
    }

    function immutableIdentityFields() {
      return request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /foundationStaff/{uid} {
      allow read: if activeStaff() && (request.auth.uid == uid || adminOrOwner());
      allow create, update, delete: if false;
    }

    match /foundationProfile/{fieldId} {
      allow read: if activeStaff();
      allow create, update, delete: if false;
    }

    match /foundationDocuments/{documentId} {
      allow read: if activeStaff();
      allow create, update, delete: if false;
    }

    match /grantOpportunities/{opportunityId} {
      allow read: if activeStaff();
      allow create, update, delete: if false;
    }

    // Application content and verification state are server-owned. Staff clients
    // use App-Check-protected callables so no client can forge answer verification,
    // rewrite editor identity, or bypass the audit trail.
    match /grantApplications/{applicationId} {
      allow read: if activeStaff();
      allow create, update, delete: if false;
    }

    match /grantApprovals/{approvalId} {
      allow read: if reviewerOrAbove();
      allow create, update, delete: if false;
    }

    match /grantSubmissions/{submissionId} {
      allow read: if activeStaff();
      allow create, update, delete: if false;
    }

    match /grantAwards/{awardId} {
      allow read: if activeStaff();
      allow create, update, delete: if false;
    }

    match /grantReportingObligations/{obligationId} {
      allow read: if activeStaff();
      allow create, update, delete: if false;
    }

    match /foundationAuditLogs/{eventId} {
      allow read: if reviewerOrAbove();
      allow create, update, delete: if false;
    }

    // Donation checkout, processor events, and transaction ledger are server-owned.
    // No public or employee client can create or alter payment records directly.
    match /donationIntents/{intentId} {
      allow read: if adminOrOwner();
      allow create, update, delete: if false;
    }

    match /donationTransactions/{transactionId} {
      allow read: if adminOrOwner();
      allow create, update, delete: if false;
    }

    match /stripeWebhookEvents/{eventId} {
      allow read: if adminOrOwner();
      allow create, update, delete: if false;
    }

    match /donationReconciliationEvents/{eventId} {
      allow read: if adminOrOwner();
      allow create, update, delete: if false;
    }
  }
}
